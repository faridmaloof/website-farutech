# ==============================================================================
# FaruTech — Configuración de act_runner (Gitea Actions)
#
# El esquema exacto cambia entre versiones. La fuente de verdad es la generada
# por el propio agente:
#   act_runner generate-config > config.yaml
# Aquí dejamos los valores RELEVANTES que debes fusionar en tu config.yaml.
#
# Puntos clave:
#  - labels: mapea `ubuntu-latest` a nuestra imagen de trabajo con docker+kubectl
#  - container.network: la red donde corren los jobs (debe poder ver a Gitea).
#  - container.volumes: monta docker.sock y el kubeconfig DENTRO de cada job.
#  - container.privileged/options: para que los jobs usen Docker.
# =================================================================================
log:
  level: info
  report: false

runner:
  enable: true
  insecure: false
  fetch_timeout: 10s
  fetch_interval: 2s
  labels:                        # <-- usa nuestra imagen de trabajo
    - ubuntu-latest:docker://farutech-ci:latest
    - ubuntu-22.04:docker://farutech-ci:latest

container:
  privileged: true
  network: farutech-ci           # misma red del compose; resuelve git.local / gitea
  docker_host: unix:///var/run/docker.sock
  options: ""
  volumes:                       # <-- monta docker.sock y kubeconfig en los jobs
    - /var/run/docker.sock:/var/run/docker.sock
    - /opt/runner/kube/config:/workspace/kube/config:ro
  valid_volumes: []
  workdir_parent: /workspace
  enable_file_network: true
  force_pull: false