# ==========================================================================
# FaruTech — Variables de entorno para Docker Compose
# Copia este archivo a `.env` y ajusta los valores (`.env` NO se versiona).
# ==========================================================================

# --- Base de datos (servicio MariaDB `db`) ---
MYSQL_DATABASE=farutech
MYSQL_USER=farutech_user
MYSQL_PASSWORD=farutech_password
MYSQL_ROOT_PASSWORD=root_password

# --- Backend (Laravel/Lumen) ---
APP_NAME=FaruTech API
APP_ENV=production
APP_DEBUG=false
# Genera una clave real con: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=base64:genera_una_clave
APP_URL=http://localhost:8080

DB_HOST=db
DB_PORT=3306
DB_DATABASE=farutech
DB_USERNAME=farutech_user
DB_PASSWORD=farutech_password