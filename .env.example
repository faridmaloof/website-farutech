# FaruTech API - Environment Variables
# Copy this file to .env and fill in your values

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=farutech
DB_USER=farutech_user
DB_PASSWORD=your_secure_password_here

# API
API_BASE_URL=https://www.farutech.com/api

# CORS (comma-separated origins)
ALLOWED_ORIGINS=https://www.farutech.com,https://farutech.com,http://localhost:4321,http://localhost:3000