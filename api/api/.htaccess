# Bloquea acceso directo a archivos sensibles
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# Bloquea listado de directorios
Options -Indexes

# Bloquea acceso directo a la carpeta src/ (solo se usa vía include, nunca por URL)
RewriteRule ^src/ - [F,L]
RewriteRule ^sql/ - [F,L]
