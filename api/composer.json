{
    "name": "farutech/api",
    "description": "Farutech API Backend",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "slim/slim": "^4.10",
        "slim/psr7": "^1.6",
        "firebase/php-jwt": "^6.8",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
